# dependencies
node_modules/

# expo / native (Continuous Native Generation: android/ and ios/ are regenerated by `expo prebuild`)
# Root-anchored (`/android/`, not `android/`) — an unanchored pattern also matches
# modules/loopback-listener/android/, which is hand-written Kotlin source (M08) that must be
# committed, not CNG output. Bug found while staging M08's native module.
.expo/
/android/
/ios/
dist/
web-build/
.kotlin/
# Local Expo native modules (modules/*/android/) keep their hand-written source under version
# control, but Gradle's own build output under each one is exactly as disposable as the root
# android/'s.
modules/*/android/build/
modules/*/android/.cxx/
expo-env.d.ts
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.orig.*

# env / secrets
.env
.env.*

# AI-tooling skill packs (per-developer, re-fetchable; decision D4)
.agents/
.claude/
.zcode/
skills-lock.json

# python (the plugin test suite; `npm run check` runs it)
__pycache__/
*.pyc

# tooling
.DS_Store
npm-debug.*
yarn-error.*
*.tsbuildinfo
coverage/
